# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic Console > API keys
ANTHROPIC_API_KEY=sk-ant-...

# Public URL of this app (used for links to promotion pages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# 사용자별 서브 도메인 주소(handle.leadstation.kr). 비워두면 /s/handle/slug 주소를 써요.
NEXT_PUBLIC_ROOT_DOMAIN=

# --- AI 뉴스레터 메일 발송: 아래 셋 중 하나만 설정 ---
# 1) SendGrid: app.sendgrid.com > Settings > API Keys (Mail Send 권한)
SENDGRID_API_KEY=
# 2) SMTP 서버
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# 3) Resend: resend.com > API Keys
RESEND_API_KEY=
# 발송 업체에서 인증한 보내는 주소 (공통, 필수)
MAIL_FROM_ADDRESS=newsletter@leadstation.kr

# --- 예약 발송 (선택) ---
# 아무 긴 임의 문자열. 크론 호출 인증용
CRON_SECRET=
# Supabase > Project Settings > API Keys > service_role (secret). 절대 공개하지 마세요
SUPABASE_SERVICE_ROLE_KEY=

# --- 뉴스레터 AI 이미지 생성 (선택) ---
# platform.openai.com > API keys
OPENAI_API_KEY=
