# Supabase project settings > API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Anthropic Console > API keys
ANTHROPIC_API_KEY=sk-ant-...

# Public URL of this app (used for links to promotion pages)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- AI 뉴스레터 메일 발송 (Resend) ---
# resend.com > API Keys
RESEND_API_KEY=re_...
# Resend에서 인증한 도메인의 보내는 주소
MAIL_FROM_ADDRESS=newsletter@leadstation.kr

# --- 예약 발송 (선택) ---
# 아무 긴 임의 문자열. 크론 호출 인증용
CRON_SECRET=
# Supabase > Project Settings > API Keys > service_role (secret). 절대 공개하지 마세요
SUPABASE_SERVICE_ROLE_KEY=

# --- 뉴스레터 AI 이미지 생성 (선택) ---
# platform.openai.com > API keys
OPENAI_API_KEY=
